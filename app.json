{
  "expo": {
    "name": "PROTAP",
    "slug": "PRO-Tepat",
    "version": "1.0.0",
    "scheme": "protokol-tanbu",
    "orientation": "portrait",
    "icon": "./assets/icon-protap.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d1731"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-protap.png",
        "backgroundColor": "#0d5ddd"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.agungsetiob.protap"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Aplikasi memerlukan akses ke foto untuk menyimpan gambar denah.",
          "savePhotosPermission": "Aplikasi memerlukan izin menyimpan denah acara ke galeri Anda.",
          "isAudioEnabled": false
        }
      ]
    ],
    "extra": {
      "API_BASE_URL": "http://10.10.23.233:8000/api/v1",
      "STORAGE_BASE_URL": "http://10.10.23.233:8000",
      "router": {},
      "eas": {
        "projectId": "fe1e42f3-b2b7-436b-a336-ff9bf392321f"
      }
    },
    "owner": "agungsetiob"
  }
}
