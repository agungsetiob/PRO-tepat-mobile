{
  "expo": {
    "name": "PRO-Tepat",
    "slug": "PRO-Tepat",
    "version": "1.0.0",
    "scheme": "protokol-tanbu",
    "orientation": "portrait",
    "icon": "./assets/beraksi-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/beraksi-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d5ddd"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/beraksi-logo.png",
        "backgroundColor": "#0d5ddd"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
