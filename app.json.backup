{
  "expo": {
    "name": "PROTAP",
    "slug": "PRO-Tepat",
    "version": "1.0.0",
    "scheme": "protokol-tanbu",
    "orientation": "portrait",
    "icon": "./assets/icon-protap.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/beraksi-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1731"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-protap.png",
        "backgroundColor": "#0d5ddd"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.agungsetiob.protap"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "API_BASE_URL": "https://protap.tanahbumbukab.go.id/api/v1",
      "STORAGE_BASE_URL": "https://protap.tanahbumbukab.go.id",
      "router": {},
      "eas": {
        "projectId": "fe1e42f3-b2b7-436b-a336-ff9bf392321f"
      }
    },
    "owner": "agungsetiob"
  }
}
